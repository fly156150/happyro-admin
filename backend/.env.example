APP_NAME="HappyRO GM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:18081

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=33062
DB_DATABASE=happyro_admin
DB_USERNAME=happyro_admin
DB_PASSWORD=

# HappyRO player database (required when the server uses SQL mode)
GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=3306
GAME_DB_DATABASE=
GAME_LOG_DB_DATABASE=happyro_log
GAME_DB_USERNAME=
GAME_DB_PASSWORD=
GAME_ACCOUNT_TABLE=login
GAME_CHARACTER_TABLE=char
GAME_LOGIN_LOG_TABLE=loginlog
GAME_PASSWORD_HASH=false
GAME_RESOURCE_ROOT=../../../work/grf-extract/kro-20211105/data/data
GAME_CONTROL_BASE_URL=http://127.0.0.1:8889
GAME_CONTROL_TOKEN=
GAME_CONTROL_CONNECT_TIMEOUT=1
GAME_CONTROL_TIMEOUT=3

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=happyro_admin_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
